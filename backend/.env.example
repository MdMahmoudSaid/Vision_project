# Local Attendance Core - example environment configuration.
# Copy to .env and adjust for your local deployment. Do not commit real secrets.

LOCAL_ATTENDANCE_DATABASE_URL=sqlite:///./local_attendance.db
LOCAL_ATTENDANCE_JWT_SECRET=change-me-to-a-random-32-byte-secret
LOCAL_ATTENDANCE_JWT_ALGORITHM=HS256
LOCAL_ATTENDANCE_ACCESS_TOKEN_EXPIRE_MINUTES=480
LOCAL_ATTENDANCE_CAMERA_INDEX=0
LOCAL_ATTENDANCE_DUPLICATE_WINDOW_SECONDS=60
LOCAL_ATTENDANCE_FACE_MATCH_THRESHOLD=4.15
