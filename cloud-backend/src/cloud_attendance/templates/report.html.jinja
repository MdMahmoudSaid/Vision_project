<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport de présence</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #333;
            line-height: 1.5;
            margin: 0;
            padding: 0;
        }
        .header {
            text-align: center;
            margin-bottom: 2rem;
            border-bottom: 2px solid #333;
            padding-bottom: 1rem;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
        }
        .meta-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f5f5f5;
        }
        .warning {
            color: #856404;
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            padding: 1rem;
            margin-bottom: 2rem;
            border-radius: 4px;
        }
        .signature-area {
            margin-top: 4rem;
            display: flex;
            justify-content: space-between;
        }
        .signature-box {
            width: 200px;
            border-top: 1px solid #333;
            text-align: center;
            padding-top: 0.5rem;
        }
        .status-complete { color: green; }
        .status-missing_departure { color: orange; }
        .status-missing_arrival { color: orange; }
        .status-no_record { color: red; }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ company_name }}</h1>
        <h2>Rapport de Présence</h2>
    </div>

    {% if report.may_be_incomplete %}
    <div class="warning">
        <strong>Attention :</strong> La période demandée s'étend au-delà de la dernière synchronisation réussie. Les données récentes peuvent être manquantes.
    </div>
    {% endif %}

    <div class="meta-info">
        <div>
            <strong>Période :</strong> {{ report.period.date_from }} au {{ report.period.date_to }}<br>
            <strong>Portée :</strong> {% if report.scope.type == 'employee' %}Employé ({{ report.scope.employee_id }}){% else %}Toute l'organisation{% endif %}
        </div>
        <div>
            <strong>Généré le :</strong> {{ report.generated_at.strftime('%Y-%m-%d %H:%M') }}
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Employé</th>
                <th>Date</th>
                <th>Arrivée</th>
                <th>Départ</th>
                <th>Durée (min)</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for row in report.rows %}
            <tr>
                <td>{{ row.employee_name }} ({{ row.employee_id }})</td>
                <td>{{ row.date }}</td>
                <td>{{ row.arrival_time.strftime('%H:%M:%S') if row.arrival_time else '-' }}</td>
                <td>{{ row.departure_time.strftime('%H:%M:%S') if row.departure_time else '-' }}</td>
                <td>{{ row.worked_duration_minutes if row.worked_duration_minutes is not none else '-' }}</td>
                <td class="status-{{ row.completeness.value }}">
                    {% if row.completeness.value == 'complete' %}Complet
                    {% elif row.completeness.value == 'missing_departure' %}Départ manquant
                    {% elif row.completeness.value == 'missing_arrival' %}Arrivée manquante
                    {% else %}Aucun enregistrement{% endif %}
                    {% if row.corrected %} (Corrigé){% endif %}
                </td>
            </tr>
            {% endfor %}
            {% if not report.rows %}
            <tr>
                <td colspan="6" style="text-align: center;">Aucune donnée trouvée pour cette période.</td>
            </tr>
            {% endif %}
        </tbody>
    </table>

    <div class="signature-area">
        <div class="signature-box">
            Visa Employé(s)
        </div>
        <div class="signature-box">
            Visa Direction
        </div>
    </div>
</body>
</html>
