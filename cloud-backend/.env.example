# Copy to .env and adjust before any real deployment.

# PostgreSQL in production, e.g.:
#   CLOUD_ATTENDANCE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/cloud_attendance
# Defaults to a local SQLite file, fine for development only.
CLOUD_ATTENDANCE_DATABASE_URL=sqlite:///./cloud_attendance.db

# Must be a long random secret in production — tokens signed with the
# committed default can be forged by anyone who reads this repository.
CLOUD_ATTENDANCE_JWT_SECRET=cloud-dev-secret-change-me-in-production-min32

# JSON object mapping a site identifier to its sync API key. One entry per
# guard-post PC that pushes sync batches (see backend/'s LOCAL_ATTENDANCE_SYNC_API_KEY).
CLOUD_ATTENDANCE_SYNC_API_KEYS={"default-site": "pointage-secret-key"}
